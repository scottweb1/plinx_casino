# Kopiér til .env (Vite læser VITE_-variabler). Publishable key er lavet til at ligge i browseren.
# Læg ALDRIG databasens adgangskode (postgres-password) eller en service_role-nøgle her.
VITE_SUPABASE_URL=https://DIT-PROJEKT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
# Konti bruger Supabase Auth, som kræver en mail-adresse. Spillet laver en falsk én ud fra brugernavnet
# (der sendes aldrig mails). Domænet skal være et rigtigt domæne med MX-records.
VITE_AUTH_EMAIL_DOMAIN=gmail.com
